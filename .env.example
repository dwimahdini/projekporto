# Salin ke .env.local — JANGAN commit .env.local ke Git.
# Nilai di bawah ini contoh, isi dengan punyamu sendiri.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# HANYA dipakai di server (route handler / server action).
# Jangan pernah pakai di komponen client ('use client').
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Pembayaran ---
# PAYMENT_PROVIDER: "mock" atau "midtrans".
# Kosong / tidak dikenal = "midtrans" (mock TIDAK aktif secara default).
# Midtrans belum diimplementasikan di Tahap 5 — kalau dipilih,
# halaman bayar menampilkan "Pembayaran belum tersedia".
PAYMENT_PROVIDER=midtrans
# Mock HANYA aktif kalau SEMUA ini terpenuhi:
#   PAYMENT_PROVIDER=mock DAN ALLOW_MOCK_PAYMENT=true
#   DAN VERCEL_ENV bukan "production".
# JANGAN diaktifkan di environment Production.
ALLOW_MOCK_PAYMENT=false
# VERCEL_ENV diisi otomatis oleh Vercel (production/preview/development).
# Di lokal, biarkan kosong (dianggap bukan production).

# --- Midtrans (NANTI, saat integrasi — Tahap 5 hanya kerangka) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxx
EMAIL_FROM="Portofolio <noreply@group.portofolio.my.id>"

# --- Aplikasi ---
NEXT_PUBLIC_APP_URL=https://group.portofolio.my.id
NEXT_PUBLIC_ROOT_DOMAIN=portofolio.my.id
# Token order: dibuat server, minimal 32 byte acak.
# Masa berlaku draft: 14 hari (lihat orders.draft_expires_at).
ORDER_TOKEN_TTL_DAYS=14

# --- Cron cleanup draft (Vercel Cron) ---
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=isi-dengan-string-acak-panjang
